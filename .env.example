# Default domain / profile for the CLI
NAMECHEAP_DOMAIN=example.com
# NAMECHEAP_PROFILE=default

# Where `ncf login` saves sessions (default: ~/.config/namecheap-forwarder)
# NAMECHEAP_SESSION_DIR=

# Optional alternatives to private terminal prompts / saved credentials.
# Terminal login saves credentials by default; --no-save-credentials opts out.
# NAMECHEAP_USERNAME=
# NAMECHEAP_PASSWORD=

# Use a session without a file (CI / serverless). Values from default.session.json.
# NAMECHEAP_SESSION_COOKIES=
# NAMECHEAP_NCCOMPLIANCE_TOKEN=

# Remote browser for the stealth client (e.g. output of `ncf serve`, or Browserless)
# NAMECHEAP_BROWSER_WS=ws://127.0.0.1:3000/namecheap

# Optional Base32 authenticator setup secret or otpauth URI
# NAMECHEAP_TOTP_SECRET=
