# Namecheap Configuration
NAMECHEAP_DOMAIN=example.com

# Optional credentials for automated/headless login
NAMECHEAP_USERNAME=your_namecheap_username
NAMECHEAP_PASSWORD=your_namecheap_password

# Base32 TOTP seed from your authenticator app. Enables clearing the 2FA gate
# with no human in the loop. Takes precedence over <sessionDir>/<domain>.totp.
# Treat this like a password: it grants 2FA access indefinitely. Prefer
# `ncf 2fa:setup` for local use, which writes the file with mode 0600.
NAMECHEAP_TOTP_SECRET=ABCDEFGHIJKLMNOP

# Direct HTTP / Serverless session tokens (from .session.json)
NAMECHEAP_SESSION_COOKIES=".ncauth=...; x-ncpl-csrf=..."
NAMECHEAP_NCCOMPLIANCE_TOKEN="182ce3e8-8f25-..."

# Remote Browser WebSocket URL (e.g. Browserless, Camoufox, or local `ncf serve`)
NAMECHEAP_BROWSER_WS=ws://localhost:3000

# Directory to save session files (defaults to current directory)
NAMECHEAP_SESSION_DIR=./
